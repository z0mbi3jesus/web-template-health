{
  "name": "web-template-health",
  "version": "0.1.0",
  "description": "Healthcare appointment management system with Supabase backend",
  "main": "server-supabase.js",
  "scripts": {
    "start": "node server-supabase.js",
    "dev": "nodemon server-supabase.js",
    "frontend": "node frontend-server.js",
    "security-check": "node scripts/security-check.js",
    "test-supabase": "node scripts/test-supabase.js",
    "precommit": "npm run security-check",
    "test": "node --test scripts/security-regression.test.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z0mbi3jesus/web-template-health.git"
  },
  "keywords": [
    "healthcare",
    "appointments",
    "supabase",
    "medical",
    "booking"
  ],
  "author": "HealthCare Plus",
  "license": "UNLICENSED",
  "private": true,
  "bugs": {
    "url": "https://github.com/z0mbi3jesus/web-template-health/issues"
  },
  "homepage": "https://github.com/z0mbi3jesus/web-template-health#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.4",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "axios": "1.14.0",
    "jws": "3.2.3",
    "path-to-regexp": "8.4.1"
  }
