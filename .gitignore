# =====================================================
# Healthcare Appointment System - .gitignore
# =====================================================

# Environment Variables (CRITICAL - Contains API Keys)
.env
.env.local
.env.development
.env.test
.env.production
.env.staging

# Supabase Configuration (if you create local config files)
supabase/.env
.supabase/

# =====================================================
# Node.js Dependencies
# =====================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Package lock files (choose one based on your package manager)
package-lock.json
yarn.lock
pnpm-lock.yaml

# =====================================================
